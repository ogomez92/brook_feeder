# Notebrook Integration (required)
NOTEBROOK_URL=https://notes.gomsen.com
NOTEBROOK_TOKEN=your-api-token
NOTEBROOK_CHANNEL=feeds

# Optional: Database location (defaults to ./feeder.db)
# FEEDER_DB_PATH=/path/to/feeder.db

# Optional: GitHub token for release tracking (`feeder releases ...`).
# Enables private-repo access and higher rate limits. If unset, feeder falls
# back to the GitHub CLI (`gh auth token`) when `gh` is logged in.
# GITHUB_TOKEN=ghp_your_personal_access_token
